# ── WebCall 配置（Mossland 版） ──

# TTS 引擎：mossland（默认）或 minimax
TTS_ENGINE=mossland

# ── Mossland TTS（默认引擎） ──
MOSSLAND_API_KEY=sk-你的Mossland API Key
MOSSLAND_VOICE_ID=1f4af4c7-eb64-49c3-bc72-de9c6ff585bc
MOSSLAND_BASE_URL=https://api.mosi.cn/v1
MOSSLAND_TTS_MODEL=moss-speech-turbo

# ── MiniMax TTS（备选引擎，设 TTS_ENGINE=minimax 时启用） ──
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=male-qn-qingse
MINIMAX_TTS_MODEL=speech-2.8-hd

# ── LLM ──
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-你的API Key
LLM_MODEL=gpt-4o

# ── STT ──
ZHIPU_API_KEY=
GROQ_API_KEY=

# ── 管理 ──
ADMIN_PASSWORD=webcall2026

# ── 角色 ──
CHARACTER_NAME=S.CHI
